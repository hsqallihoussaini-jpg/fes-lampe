DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_WHATSAPP_NUMBER="212XXXXXXXXX"
STRIPE_SECRET="sk_test_..."

# Stripe publishable key for client-side redirect
NEXT_PUBLIC_STRIPE_PUBLISHABLE="pk_test_..."

# Base URL used for success/cancel redirects (include protocol)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe webhook signing secret (set this from your Stripe dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin simple auth (do not use weak secrets in production)
ADMIN_PASSWORD="change_me"
ADMIN_JWT_SECRET="a_very_secret_key"

# Supabase (server-side service key)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="service-role-key"
SUPABASE_BUCKET="uploads"

# Optional compatibility aliases. Do not expose a service-role key with NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service-role-key"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        String  @id @default(cuid())
  title     String
  description String?
  dimensions String?
  price     Int
  image     String?
  images    String? // JSON array of image URLs
  category  String?
  inStock   Boolean @default(true)
  createdAt DateTime @default(now())
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
}

model Order {
  id      String @id @default(cuid())
  total   Int
  createdAt DateTime @default(now())
  items   String // JSON
}

model CustomRequest {
  id String @id @default(cuid())
  name String
  email String
  details String?
  dimensions String?
  fileUrl String?
  createdAt DateTime @default(now())
}
